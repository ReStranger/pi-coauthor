{
	"name": "pi-coauthor",
	"version": "0.0.1",
	"private": true,
	"description": "Claude Code-style commit and pull-request attribution for pi, with pi.dev as co-author",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"type": "module",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
